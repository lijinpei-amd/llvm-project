; A legal integer width is required for FindLoopCounter to pick an IV.
target datalayout = "n8:16:32:64"

@lftr_pointer_object = global [1 x i8] zeroinitializer

define i32 @duplicate_exit_cond(i32 %start, i32 %end, i32 %a, i32 %b) {
; CHECK-LABEL: define i32 @duplicate_exit_cond(
; CHECK-SAME: i32 [[START:%.*]], i32 [[END:%.*]], i32 [[A:%.*]], i32 [[B:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[GUARD:%.*]] = icmp slt i32 [[START]], [[END]]
; CHECK-NEXT:    br i1 [[GUARD]], label %[[LOOP_PREHEADER:.*]], label %[[EXIT:.*]]
; CHECK:       [[LOOP_PREHEADER]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ [[IV_NEXT:%.*]], %[[LOOP]] ], [ [[START]], %[[LOOP_PREHEADER]] ]
; CHECK-NEXT:    [[V:%.*]] = phi i32 [ [[SEL:%.*]], %[[LOOP]] ], [ [[A]], %[[LOOP_PREHEADER]] ]
; CHECK-NEXT:    [[IV_NEXT]] = add nsw i32 [[IV]], 1
; CHECK-NEXT:    [[EXITCOND:%.*]] = icmp slt i32 [[IV_NEXT]], [[END]]
; CHECK-NEXT:    [[SEL]] = select i1 [[EXITCOND]], i32 [[B]], i32 [[V]]
; CHECK-NEXT:    [[EXITCOND1:%.*]] = icmp ne i32 [[IV_NEXT]], [[END]]
; CHECK-NEXT:    br i1 [[EXITCOND1]], label %[[LOOP]], label %[[EXIT_LOOPEXIT:.*]]
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    [[V_LCSSA:%.*]] = phi i32 [ [[V]], %[[LOOP]] ]
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[R:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[V_LCSSA]], %[[EXIT_LOOPEXIT]] ]
; CHECK-NEXT:    ret i32 [[R]]
;
entry:
  %guard = icmp slt i32 %start, %end
  br i1 %guard, label %loop, label %exit

loop:
  %iv = phi i32 [ %start, %entry ], [ %iv.next, %loop ]
  %v = phi i32 [ %a, %entry ], [ %sel, %loop ]
  %iv.next = add nsw i32 %iv, 1
  %cmp.dup = icmp slt i32 %iv.next, %end
  %sel = select i1 %cmp.dup, i32 %b, i32 %v
  %cmp.exit = icmp slt i32 %iv.next, %end
