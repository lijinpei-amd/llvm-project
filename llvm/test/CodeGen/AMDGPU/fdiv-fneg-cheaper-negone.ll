; The cheaper negation feeds an fma: fma(fneg(-1.0/x), y, z) becomes
; fma(rcp(x), y, z). The fneg is absorbed by dropping it from the divide rather
; than landing as a source modifier on the rcp input or the fma.
define float @fma_fneg_fdiv_negone_f32(float %x, float %y, float %z) {
; CHECK-LABEL: fma_fneg_fdiv_negone_f32:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    s_waitcnt vmcnt(0) expcnt(0) lgkmcnt(0)
; CHECK-NEXT:    v_rcp_f32_e32 v0, v0
; CHECK-NEXT:    v_fma_f32 v0, v0, v1, v2
; CHECK-NEXT:    s_setpc_b64 s[30:31]
  %div = fdiv afn float -1.000000e+00, %x
  %neg = fneg float %div
  %fma = call float @llvm.fmuladd.f32(float %neg, float %y, float %z)
  ret float %fma
}

; Same under optsize (ForCodeSize path).
define float @fma_fneg_fdiv_negone_f32_optsize(float %x, float %y, float %z) optsize {
; CHECK-LABEL: fma_fneg_fdiv_negone_f32_optsize:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    s_waitcnt vmcnt(0) expcnt(0) lgkmcnt(0)
; CHECK-NEXT:    v_rcp_f32_e32 v0, v0
; CHECK-NEXT:    v_fma_f32 v0, v0, v1, v2
; CHECK-NEXT:    s_setpc_b64 s[30:31]
  %div = fdiv afn float -1.000000e+00, %x
  %neg = fneg float %div
  %fma = call float @llvm.fmuladd.f32(float %neg, float %y, float %z)
  ret float %fma
}

