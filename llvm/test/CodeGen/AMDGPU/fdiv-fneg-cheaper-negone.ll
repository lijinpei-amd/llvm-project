; Coverage for the "cheaper negation" path in
; SITargetLowering::getNegatedExpression: -1.0 / x lowers to rcp(fneg(x)), so
; its negation is 1.0 / x == rcp(x), strictly cheaper because the fneg is
; dropped. The returned negation must equal 1.0 / x, not the bare denominator x.

; fneg(-1.0 / x) == 1.0 / x == rcp(x)
define float @fneg_fdiv_negone_f32(float %x) {
; CHECK-LABEL: fneg_fdiv_negone_f32:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    s_waitcnt vmcnt(0) expcnt(0) lgkmcnt(0)
; CHECK-NEXT:    v_rcp_f32_e32 v0, v0
; CHECK-NEXT:    s_setpc_b64 s[30:31]
  %div = fdiv afn float -1.000000e+00, %x
  %neg = fneg float %div
  ret float %neg
}

; Same under optsize (ForCodeSize path).
define float @fneg_fdiv_negone_f32_optsize(float %x) optsize {
; CHECK-LABEL: fneg_fdiv_negone_f32_optsize:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    s_waitcnt vmcnt(0) expcnt(0) lgkmcnt(0)
; CHECK-NEXT:    v_rcp_f32_e32 v0, v0
; CHECK-NEXT:    s_setpc_b64 s[30:31]
  %div = fdiv afn float -1.000000e+00, %x
  %neg = fneg float %div
  ret float %neg
}

