    ; CHECK-NEXT: $vgpr3 = BUFFER_LOAD_DWORD_OFFEN $vgpr0, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 0, 0, 0, implicit $exec :: (load (s32) from %ir.g, addrspace 1)
    ; CHECK-NEXT: BUFFER_LOAD_DWORD_LDS_OFFEN_ASYNC killed $vgpr1, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 0, 0, 0, implicit $exec, implicit $m0, implicit $asyncmarker :: (load (s32) from %ir.g, addrspace 1), (store (s32) into %ir.l, addrspace 3)
    ; CHECK-NEXT: BUFFER_LOAD_DWORD_LDS_OFFEN_ASYNC killed $vgpr2, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 0, 0, 0, implicit $exec, implicit $m0, implicit $asyncmarker :: (load (s32) from %ir.g, addrspace 1), (store (s32) into %ir.l, addrspace 3)
    ; CHECK-NEXT: ASYNCMARK implicit-def $asyncmarker, implicit $asyncmarker
    ; CHECK-NEXT: $vgpr4 = BUFFER_LOAD_UBYTE_OFFEN killed $vgpr3, killed $sgpr0_sgpr1_sgpr2_sgpr3, 0, 0, 0, 0, implicit $exec :: (load (s8) from %ir.g, addrspace 1)
    ; CHECK-NEXT: DS_WRITE_B8_gfx9 killed $vgpr0, killed $vgpr4, 0, 0, implicit $exec :: (store (s8) into %ir.l, addrspace 3)
    ; CHECK-NEXT: S_ENDPGM 0
    $vgpr3 = BUFFER_LOAD_DWORD_OFFEN $vgpr0, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 0, 0, 0, implicit $exec :: (load (s32) from %ir.g, addrspace 1)
    $vgpr4 = BUFFER_LOAD_UBYTE_OFFEN $vgpr3, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 0, 0, 0, implicit $exec :: (load (s8) from %ir.g, addrspace 1)
    BUFFER_LOAD_DWORD_LDS_OFFEN_ASYNC $vgpr1, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 0, 0, 0, implicit $exec, implicit $m0, implicit $asyncmarker :: (load (s32) from %ir.g, addrspace 1), (store (s32) into %ir.l, addrspace 3)
    BUFFER_LOAD_DWORD_LDS_OFFEN_ASYNC $vgpr2, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 0, 0, 0, implicit $exec, implicit $m0, implicit $asyncmarker :: (load (s32) from %ir.g, addrspace 1), (store (s32) into %ir.l, addrspace 3)
    ASYNCMARK implicit-def $asyncmarker, implicit $asyncmarker
    DS_WRITE_B8_gfx9 $vgpr0, $vgpr4, 0, 0, implicit $exec :: (store (s8) into %ir.l, addrspace 3)
    S_ENDPGM 0
