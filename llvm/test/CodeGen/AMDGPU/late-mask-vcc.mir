---
name: dead_vcc_pair
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-LABEL: name: dead_vcc_pair
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $sgpr0_sgpr1 = V_CMP_GT_I32_e64 3, $vgpr0, implicit $exec
    ; CHECK-NEXT: $vgpr1 = V_CNDMASK_B32_e64 0, $vgpr1, 0, $vgpr2, killed $sgpr0_sgpr1, implicit $exec
    ; CHECK-NEXT: FAKE_USE $vgpr1
    ; CHECK-NEXT: S_ENDPGM 0
    $sgpr0_sgpr1 = V_CMP_GT_I32_e64 3, $vgpr0, implicit $exec
    $vgpr1 = V_CNDMASK_B32_e64 0, $vgpr1, 0, $vgpr2, killed $sgpr0_sgpr1, implicit $exec
    FAKE_USE $vgpr1
    S_ENDPGM 0
...
