  define amdgpu_kernel void @intervening_vcc_def() { ret void }
  define amdgpu_kernel void @intervening_exec_read() { ret void }
  define amdgpu_kernel void @intervening_exec_def() { ret void }
  define amdgpu_kernel void @mask_redefined_before_consumer() { ret void }
